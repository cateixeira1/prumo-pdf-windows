<?xml version="1.0" encoding="utf-8"?>
<!--
  Manifesto do pacote MSIX do Prumo PDF. O build/msix.ps1 troca os @VALORES@.
  Para a Microsoft Store, Identity Name, Publisher e PublisherDisplayName vêm do Partner Center
  (Gerenciamento de produto > Identidade do produto) e precisam ser idênticos.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity Name="@IDENTITY_NAME@" Publisher="@PUBLISHER@" Version="@VERSION@" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>@DISPLAY_NAME@</DisplayName>
    <PublisherDisplayName>@PUBLISHER_DISPLAY_NAME@</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="pt-BR" />
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="PrumoPDF" Executable="PrumoPDF.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="@DISPLAY_NAME@"
        Description="PDF e OCR no seu computador"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- “Abrir com” para .pdf. O item “Converter em PDF com o Prumo” do menu do Explorer
             (hoje gravado no registro pelo instalador) ainda NÃO está aqui: precisa de outra solução. -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="pdf">
            <uap:SupportedFileTypes>
              <uap:FileType>.pdf</uap:FileType>
            </uap:SupportedFileTypes>
            <uap:DisplayName>Documento PDF (Prumo PDF)</uap:DisplayName>
          </uap:FileTypeAssociation>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
